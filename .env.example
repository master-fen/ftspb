# Локальная база разработки — PostgreSQL 17 на машине разработчика, без TLS.
# Против неё идут разработка, тесты и все скрипты из scripts/.
# Пример: postgresql://postgres:ПАРОЛЬ@localhost:5432/ftspb_local
#
# Шифрование включается автоматически по хосту (src/db/ssl.ts): для localhost
# и 127.0.0.1 — выключено, для любого другого хоста — verify-full с вшитым в
# код CA Timeweb. Отдельного флага нет, править строку под окружение не нужно.
DATABASE_URL=

# Боевая база (PostgreSQL 17 в Timeweb, база default_db, пользователь
# gen_user). Нужна ТОЛЬКО скрипту `bun run db:refresh`, который снимает с неё
# дамп через pg_dump — на чтение. Приложение и остальные скрипты эту
# переменную не читают вовсе.
#
# Строка обязана заканчиваться на ?sslmode=verify-full: pg_dump и psql не
# видят опций postgres.js и берут режим TLS из строки подключения и
# переменных PGSSLMODE/PGSSLROOTCERT (их db-refresh выставляет сам,
# указывая на certs/timeweb-ca.crt).
PROD_DATABASE_URL=

# Схема Postgres внутри default_db: "public" — боевые данные (по умолчанию),
# "dev" — черновые. См. docs/schema.md.
DB_SCHEMA=

# S3-бакет ftspb-media, endpoint https://s3.twcstorage.ru, регион ru-1.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY_ID=
S3_SECRET=
S3_REGION=

SESSION_SECRET=
