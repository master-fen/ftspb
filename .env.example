# PostgreSQL 17 (Timeweb), одна база default_db, один пользователь gen_user.
# Строка подключения обязана заканчиваться на ?sslmode=verify-full и требует
# CA-сертификат Timeweb на машине, с которой идёт подключение.
DATABASE_URL=

# Схема Postgres внутри default_db: "public" — боевые данные (по умолчанию),
# "dev" — черновые. См. docs/schema.md.
DB_SCHEMA=

# S3-бакет ftspb-media, endpoint https://s3.twcstorage.ru, регион ru-1.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY_ID=
S3_SECRET=

SESSION_SECRET=
